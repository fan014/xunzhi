# 复制为 .env 后填写。仅服务端读取，任何接口与日志都不会回显 Key。
DEEPSEEK_API_KEY=

# 数据根目录（相对项目根或绝对路径）
XUNZHI_DATA_DIR=data

# 模型名固定，如需切换只改这里（学生界面不可见）
XUNZHI_MODEL=deepseek-flash

# 生成硬超时与无进展提示（秒）
XUNZHI_GENERATE_TIMEOUT=180
XUNZHI_STALL_HINT=60

# 上传上限
XUNZHI_MAX_SOURCES=10
XUNZHI_MAX_PAGES=40
XUNZHI_MAX_TOTAL_MB=150
XUNZHI_MAX_PROGRESS_CHARS=500

# 服务监听
XUNZHI_HOST=127.0.0.1
XUNZHI_PORT=8000

# 仅离线调试/自动测试：1 启用确定性模型替身（界面与响应会带 is_test_double=true）
XUNZHI_ALLOW_FAKE=0
XUNZHI_FAKE_MODE=ok